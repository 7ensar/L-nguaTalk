@model AdminUserDetailsViewModel
@{
    ViewData["Title"] = "Kullanıcı Detayı";
}

<div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Listeye dön</a>
    <div class="d-flex gap-2">
        <span class="badge text-bg-warning">@Model.ReportCount rapor</span>
        <span class="badge text-bg-danger">@Model.OpenReportCount açık</span>
    </div>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success border-0">@ok</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger border-0">@err</div>
}

<div class="row g-3 g-lg-4">
    <div class="col-12 col-lg-7">
        <div class="panel-card mb-3">
            <h2 class="h5 mb-3">@Model.DisplayName</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">E-posta</dt>
                <dd class="col-sm-8 text-break">@Model.Email</dd>
                <dt class="col-sm-4">Kayıt</dt>
                <dd class="col-sm-8">@Model.CreatedAtUtc.ToLocalTime().ToString("g")</dd>
                <dt class="col-sm-4">Son giriş</dt>
                <dd class="col-sm-8">@(Model.LastLoginAtUtc?.ToLocalTime().ToString("g") ?? "—")</dd>
                <dt class="col-sm-4">Roller</dt>
                <dd class="col-sm-8">
                    @(Model.Roles.Count == 0 ? "Yok" : string.Join(", ", Model.Roles))
                </dd>
                <dt class="col-sm-4">Premium</dt>
                <dd class="col-sm-8">
                    @if (Model.IsPremium)
                    {
                        <span class="badge text-bg-warning">Premium</span>
                        <div class="small text-muted">Bitiş: @(Model.PremiumExpiresAtUtc?.ToLocalTime().ToString("g") ?? "süresiz")</div>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Standart</span>
                    }
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <form asp-action="SetPremium" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <input type="hidden" name="days" value="30" />
                            <button class="btn btn-sm btn-warning" type="submit">+30 gün Premium</button>
                        </form>
                        <form asp-action="SetPremium" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <input type="hidden" name="days" value="0" />
                            <button class="btn btn-sm btn-outline-secondary" type="submit">Premium kaldır</button>
                        </form>
                    </div>
                </dd>
                <dt class="col-sm-4">Durum</dt>
                <dd class="col-sm-8">
                    @if (Model.IsBanned)
                    {
                        <span class="badge text-bg-danger">Banlı</span>
                        @if (Model.ActiveBanType == BanType.Temporary)
                        {
                            <span class="badge text-bg-warning">Süreli</span>
                        }
                        else if (Model.ActiveBanType == BanType.Permanent)
                        {
                            <span class="badge text-bg-dark">Kalıcı</span>
                        }
                        <div class="small text-muted mt-1">@Model.BanReason</div>
                        <div class="small text-muted">Başlangıç: @(Model.BannedAtUtc?.ToLocalTime().ToString("g") ?? "—")</div>
                        <div class="small text-muted">
                            Bitiş:
                            @(Model.ActiveBanExpiresAtUtc.HasValue
                                ? Model.ActiveBanExpiresAtUtc.Value.ToLocalTime().ToString("g")
                                : "Kalıcı")
                        </div>
                    }
                    else
                    {
                        <span class="badge text-bg-success">Aktif</span>
                    }
                </dd>
                <dt class="col-sm-4">Ana dil</dt>
                <dd class="col-sm-8">@(Model.NativeLanguageCode?.ToUpperInvariant() ?? "—")</dd>
                <dt class="col-sm-4">Hedef dil</dt>
                <dd class="col-sm-8">
                    @(Model.TargetLanguageCode?.ToUpperInvariant() ?? "—")
                    @if (!string.IsNullOrEmpty(Model.LanguageLevel))
                    {
                        <span class="badge text-bg-secondary ms-1">@Model.LanguageLevel</span>
                    }
                </dd>
                <dt class="col-sm-4">Bio</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Bio) ? "—" : Model.Bio)</dd>
                <dt class="col-sm-4">İlgi alanları</dt>
                <dd class="col-sm-8">
                    @if (Model.Interests.Count == 0)
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        <div class="interest-tags">
                            @foreach (var tag in Model.Interests)
                            {
                                <span class="interest-tag">@tag</span>
                            }
                        </div>
                    }
                </dd>
            </dl>
        </div>

        <div class="panel-card mb-3">
            <h2 class="h6 mb-3">Ban geçmişi (@Model.BanHistory.Count)</h2>
            @if (Model.BanHistory.Count == 0)
            {
                <p class="text-muted mb-0">Bu kullanıcı için ban kaydı yok.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table admin-table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Tür</th>
                                <th>Neden</th>
                                <th>Başlangıç</th>
                                <th>Bitiş</th>
                                <th>Admin</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ban in Model.BanHistory)
                            {
                                <tr>
                                    <td>
                                        @(ban.BanType == BanType.Temporary ? "Süreli" : "Kalıcı")
                                    </td>
                                    <td class="small">@ban.Reason</td>
                                    <td class="small text-nowrap">@ban.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                    <td class="small text-nowrap">
                                        @(ban.ExpiresAtUtc?.ToLocalTime().ToString("g") ?? "—")
                                    </td>
                                    <td class="small">@ban.CreatedByAdminName</td>
                                    <td>
                                        @if (ban.IsActive)
                                        {
                                            <span class="badge text-bg-danger">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Kapalı</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="panel-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 mb-0">Raporlar (@Model.ReportCount)</h2>
                <a class="btn btn-sm btn-outline-secondary"
                   asp-area="Admin" asp-controller="Moderation" asp-action="Index">Tüm moderasyon</a>
            </div>

            @if (Model.Reports.Count == 0)
            {
                <p class="text-muted mb-0">Bu kullanıcı için henüz rapor yok.</p>
            }
            else
            {
                <div class="vstack gap-2">
                    @foreach (var report in Model.Reports)
                    {
                        <div class="report-detail-card">
                            <div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
                                <strong>@report.Reason</strong>
                                <span class="badge text-bg-secondary">@report.Status</span>
                            </div>
                            <div class="small text-muted mb-1">
                                @report.CreatedAtUtc.ToLocalTime().ToString("g")
                                · Bildiren: @report.ReporterDisplayName
                                @if (!string.IsNullOrEmpty(report.ReasonCode))
                                {
                                    <span>· @report.ReasonCode</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(report.Details))
                            {
                                <p class="mb-1 small">@report.Details</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(report.AutoAction))
                            {
                                <div class="small text-warning">Otomatik aksiyon: @report.AutoAction</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(report.AdminNotes))
                            {
                                <div class="small text-muted">Admin notu: @report.AdminNotes</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(report.RoomId))
                            {
                                <div class="small text-muted">Oda: <code>@report.RoomId</code></div>
                            }
                            <a class="small"
                               asp-area="Admin" asp-controller="Reports" asp-action="Details" asp-route-id="@report.Id">
                                Rapor detayına git →
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-5">
        <div class="panel-card">
            <h2 class="h6 mb-3">Moderasyon</h2>
            @if (Model.IsBanned)
            {
                <form asp-action="Unban" method="post" class="vstack gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <p class="small text-muted mb-0">
                        Aktif banı kaldırmak için onaylayın.
                        @if (Model.ActiveBanExpiresAtUtc.HasValue)
                        {
                            <span>Otomatik bitiş: @Model.ActiveBanExpiresAtUtc.Value.ToLocalTime().ToString("g")</span>
                        }
                    </p>
                    <button type="submit" class="btn btn-success w-100">Banı Kaldır</button>
                </form>
            }
            else
            {
                <form asp-action="Ban" method="post" class="vstack gap-3" id="banUserForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserId" value="@Model.Id" />

                    <div>
                        <label class="form-label" for="Reason">Ban nedeni</label>
                        <textarea class="form-control" id="Reason" name="Reason" rows="3" required minlength="3"></textarea>
                    </div>

                    <div>
                        <span class="form-label d-block">Ban türü</span>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="BanType" id="banTypeTemporary" value="temporary" checked>
                            <label class="form-check-label" for="banTypeTemporary">Süreli ban</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="BanType" id="banTypePermanent" value="permanent">
                            <label class="form-check-label" for="banTypePermanent">Kalıcı ban</label>
                        </div>
                    </div>

                    <div id="tempBanFields" class="vstack gap-3">
                        <div>
                            <label class="form-label" for="DurationDays">Süre (gün)</label>
                            <input class="form-control" type="number" id="DurationDays" name="DurationDays"
                                   min="1" max="365" step="1" value="1" placeholder="örn. 7" />
                            <div class="form-text text-muted">1–365 gün. Tarih girersen gün yerine tarih kullanılır.</div>
                        </div>
                        <div>
                            <label class="form-label" for="BanUntilLocal">veya bitiş tarihi</label>
                            <input class="form-control" type="datetime-local" id="BanUntilLocal" name="BanUntilLocal" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Banı Uygula</button>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const tempRadio = document.getElementById("banTypeTemporary");
            const permRadio = document.getElementById("banTypePermanent");
            const fields = document.getElementById("tempBanFields");
            const days = document.getElementById("DurationDays");
            const until = document.getElementById("BanUntilLocal");
            if (!tempRadio || !permRadio || !fields) return;

            const sync = () => {
                const isTemp = tempRadio.checked;
                fields.classList.toggle("d-none", !isTemp);
                if (days) days.disabled = !isTemp;
                if (until) until.disabled = !isTemp;
            };

            tempRadio.addEventListener("change", sync);
            permRadio.addEventListener("change", sync);
            sync();
        })();
    </script>
}

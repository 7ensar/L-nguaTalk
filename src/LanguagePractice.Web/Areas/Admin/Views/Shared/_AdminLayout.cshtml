@using LanguagePractice.Core.Constants
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Admin · LinguaTalk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <div class="admin-shell">
        <aside class="admin-sidebar d-none d-lg-flex flex-column">
            <div class="admin-brand px-3 py-3 border-bottom border-secondary-subtle">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-white fw-semibold d-inline-flex align-items-center gap-2">
                    <span class="lt-logo-mark" style="width:32px;height:32px;font-size:.85rem;">L</span>
                    LinguaTalk Admin
                </a>
                <div class="small text-white-50 mt-1">Yönetim paneli</div>
            </div>
            <partial name="_AdminNav" />
        </aside>

        <div class="offcanvas offcanvas-start admin-offcanvas d-lg-none" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
            <div class="offcanvas-header border-bottom border-secondary-subtle">
                <h5 class="offcanvas-title text-white" id="adminSidebarLabel">Admin</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="admin-brand px-3 py-3 border-bottom border-secondary-subtle">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none text-white fw-semibold d-inline-flex align-items-center gap-2">
                        <span class="lt-logo-mark" style="width:32px;height:32px;font-size:.85rem;">L</span>
                        LinguaTalk Admin
                    </a>
                </div>
                <partial name="_AdminNav" />
            </div>
        </div>

        <div class="admin-main">
            <header class="admin-topbar d-flex align-items-center justify-content-between gap-2 px-3 px-md-4">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <button class="btn btn-outline-secondary d-lg-none" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
                        Menü
                    </button>
                    <div class="min-w-0">
                        <div class="fw-semibold text-truncate">@ViewData["Title"]</div>
                        <div class="small text-muted d-none d-sm-block">Sadece @AppRoles.Admin rolü erişebilir</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    @await Component.InvokeAsync("LanguageSwitcher")
                    <div class="small text-muted text-truncate d-none d-md-block">@User.Identity?.Name</div>
                </div>
            </header>

            <main class="admin-content px-3 px-md-4 py-3 py-md-4">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

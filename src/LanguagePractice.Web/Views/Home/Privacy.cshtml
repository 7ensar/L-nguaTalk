@using LanguagePractice.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Privacy_Title"].Value;
}

<section class="auth-stage">
    <div class="glass-card auth-card" style="width:min(100%,640px);">
        <h1 class="h3 mb-3">@Localizer["Privacy_Title"]</h1>
        <p class="text-muted mb-0">LinguaTalk</p>
    </div>
</section>

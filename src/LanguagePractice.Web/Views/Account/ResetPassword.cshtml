@model LanguagePractice.Web.ViewModels.ResetPasswordViewModel
@using LanguagePractice.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Account_ResetTitle"].Value;
}

<section class="auth-stage">
    <div class="glass-card auth-card">
        <h1 class="h3">@Localizer["Account_ResetTitle"]</h1>
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <div class="mb-3">
                <label asp-for="Password" class="form-label text-muted">@Localizer["Register_Password"]</label>
                <input asp-for="Password" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label text-muted">@Localizer["Register_ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary w-100">@Localizer["Account_ResetSubmit"]</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model LanguagePractice.Web.ViewModels.RegisterViewModel
@using LanguagePractice.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Register_Title"].Value;
}

<section class="auth-stage">
    <div class="glass-card auth-card">
        <div class="brand-kicker">LinguaTalk</div>
        <h1 class="h3">@Localizer["Register_Title"]</h1>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label text-muted">@Localizer["Register_DisplayName"]</label>
                <input asp-for="DisplayName" class="form-control" autocomplete="nickname" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label text-muted">@Localizer["Register_Email"]</label>
                <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label text-muted">@Localizer["Register_Password"]</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label text-muted">@Localizer["Register_Confirm"]</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">@Localizer["Register_Submit"]</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

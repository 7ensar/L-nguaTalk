@model LanguagePractice.Web.ViewModels.ForgotPasswordViewModel
@using LanguagePractice.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer
@{
    ViewData["Title"] = Localizer["Account_ForgotTitle"].Value;
}

<section class="auth-stage">
    <div class="glass-card auth-card">
        <h1 class="h3">@Localizer["Account_ForgotTitle"]</h1>
        <p class="text-muted">@Localizer["Account_ForgotLead"]</p>
        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label text-muted">@Localizer["Login_Email"]</label>
                <input asp-for="Email" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary w-100">@Localizer["Account_ForgotSubmit"]</button>
        </form>
    </div>
</section>

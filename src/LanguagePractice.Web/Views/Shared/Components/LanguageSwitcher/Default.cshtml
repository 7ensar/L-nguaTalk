@model LanguagePractice.Web.ViewComponents.LanguageSwitcherModel
@using LanguagePractice.Web.Localization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer

<div class="language-switcher" data-lang-switcher>
    <button class="glass-btn language-switcher-btn"
            type="button"
            id="languageSwitcherBtn"
            aria-expanded="false"
            aria-controls="languageMenuPanel"
            aria-haspopup="true"
            aria-label="@Localizer["Lang_Change"]">
        <span class="lang-code text-uppercase">@Model.CurrentCode.Split('-')[0]</span>
        <span class="d-none d-md-inline text-truncate lang-native">@Model.Current.NativeName</span>
        <span class="language-caret" aria-hidden="true"></span>
    </button>

    <div class="language-menu" id="languageMenuPanel" role="menu" hidden>
        <div class="language-menu-label">@Localizer["Lang_Label"]</div>
        <div class="language-menu-list">
            @foreach (var culture in Model.Cultures)
            {
                <form asp-controller="Culture" asp-action="Set" method="post" class="m-0" role="none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="culture" value="@culture.Code" />
                    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                    <button type="submit"
                            role="menuitem"
                            class="language-item @(culture.Code == Model.CurrentCode ? "active" : null)">
                        <span class="fw-semibold">@culture.NativeName</span>
                        <span class="small d-block">@culture.EnglishName</span>
                    </button>
                </form>
            }
        </div>
    </div>
</div>

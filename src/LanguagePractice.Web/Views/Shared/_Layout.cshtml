@using LanguagePractice.Core.Constants
@using LanguagePractice.Web.Localization
@using System.Globalization
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Localizer
@{
    var uiCulture = CultureInfo.CurrentUICulture.Name;
    var isRtl = AppCultures.IsRtl(uiCulture);
    var isAuth = User.Identity?.IsAuthenticated == true;
    var display = isAuth ? (User.Identity!.Name ?? "U") : "";
    var initial = string.IsNullOrWhiteSpace(display) ? "?" : char.ToUpperInvariant(display.Trim()[0]).ToString();
    var hideFooter = ViewData["HideFooter"] as bool? == true;
}
<!DOCTYPE html>
<html lang="@AppCultures.Normalize(uiCulture)" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] · LinguaTalk</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="lt-header">
        <div class="lt-header-inner">
            <a class="lt-logo" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="lt-logo-mark">L</span>
                <span class="lt-logo-text">LinguaTalk</span>
            </a>

            <div class="lt-header-actions">
                @await Component.InvokeAsync("LanguageSwitcher")

                @if (isAuth)
                {
                    <div class="profile-switcher" data-profile-switcher>
                        <button class="glass-btn profile-toggle"
                                type="button"
                                id="profileSwitcherBtn"
                                aria-expanded="false"
                                aria-controls="profileMenuPanel"
                                aria-haspopup="true"
                                aria-label="@Localizer["Nav_Profile"]">
                            <span class="profile-avatar">@initial</span>
                            <span class="d-none d-sm-inline text-truncate profile-toggle-name">@display</span>
                            <span class="language-caret" aria-hidden="true"></span>
                        </button>
                        <div class="profile-menu" id="profileMenuPanel" role="menu" hidden>
                            <a class="profile-menu-item" role="menuitem" asp-area="" asp-controller="Profile" asp-action="Index">@Localizer["Nav_Profile"]</a>
                            <a class="profile-menu-item" role="menuitem" asp-area="" asp-controller="Profile" asp-action="Edit">@Localizer["Nav_EditProfile"]</a>
                            <a class="profile-menu-item" role="menuitem" asp-area="" asp-controller="Friends" asp-action="Index">@Localizer["Nav_Friends"]</a>
                            <a class="profile-menu-item" role="menuitem" asp-area="" asp-controller="Match" asp-action="Lobby">@Localizer["Nav_Lobby"]</a>
                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <a class="profile-menu-item" role="menuitem" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["Nav_Admin"]</a>
                            }
                            <div class="profile-menu-divider" role="separator"></div>
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="profile-menu-item profile-menu-logout" role="menuitem">@Localizer["Nav_Logout"]</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="btn btn-nav-login btn-sm" asp-area="" asp-controller="Account" asp-action="Login">@Localizer["Nav_Login"]</a>
                    <a class="btn btn-primary btn-sm btn-nav-register" asp-area="" asp-controller="Account" asp-action="Register">@Localizer["Nav_Register"]</a>
                }
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    @if (!hideFooter)
    {
        <footer class="site-footer">
            <div class="site-shell footer-inner">
                <span>@Localizer["Footer_Copyright", DateTime.UtcNow.Year]</span>
                <nav class="footer-links" aria-label="@Localizer["Legal_NavLabel"]">
                    <a asp-area="" asp-controller="Legal" asp-action="About">@Localizer["Legal_About"]</a>
                    <a asp-area="" asp-controller="Legal" asp-action="Privacy">@Localizer["Legal_Privacy"]</a>
                    <a asp-area="" asp-controller="Legal" asp-action="Terms">@Localizer["Legal_Terms"]</a>
                    <a asp-area="" asp-controller="Legal" asp-action="Cookies">@Localizer["Legal_Cookies"]</a>
                    <a asp-area="" asp-controller="Legal" asp-action="Community">@Localizer["Legal_Community"]</a>
                    <a asp-area="" asp-controller="Legal" asp-action="Contact">@Localizer["Legal_Contact"]</a>
                </nav>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/lang-tiles.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
